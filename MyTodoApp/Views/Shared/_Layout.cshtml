<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyTodoApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyTodoApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <style>
            .custom-navbar {
                background: linear-gradient(90deg, #4f46e5, #3b82f6);
                padding: 1rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

                .custom-navbar a {
                    color: #ffffff;
                    text-decoration: none;
                    margin-right: 1.2rem;
                    font-weight: 500;
                    transition: opacity 0.3s ease;
                }

                    .custom-navbar a:hover {
                        opacity: 0.8;
                    }

            .custom-search input[type="text"] {
                padding: 0.4rem 0.8rem;
                border: none;
                border-radius: 20px;
                outline: none;
                margin-right: 0.5rem;
            }

            .custom-search button {
                background-color: #2563eb;
                color: #fff;
                padding: 0.4rem 0.9rem;
                border: none;
                border-radius: 20px;
                cursor: pointer;
                transition: background 0.3s ease;
            }

                .custom-search button:hover {
                    background-color: #1d4ed8;
                }
        </style>

        <nav class="custom-navbar">
            <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap">
                <a asp-area="" asp-controller="Todo" asp-action="Index" class="navbar-brand">📋 MyTodoApp</a>
                <div class="d-flex align-items-center flex-wrap">
                    <a asp-controller="Todo" asp-action="Index">Home</a>
                    <a asp-controller="Todo" asp-action="Create">Create</a>

                    @{
                        var userId = Context.Session.GetInt32("UserId");
                        var username = Context.Session.GetString("username");
                    }

                    @if (userId != null)
                    {
                        <form class="custom-search d-flex align-items-center" asp-action="Search" asp-controller="Todo" method="post">
                            <input name="query" type="text" placeholder="Search Todos..." />
                            <button type="submit">🔍</button>
                        </form>

                        <a asp-controller="User" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <a asp-controller="User" asp-action="Login">Login</a>
                        <a asp-controller="User" asp-action="Register">Sign up</a>
                    }

                    @if (username != null)
                    {
                        <span class="ms-2 text-white fw-bold">Hello,  @username!</span>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MyTodoApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
